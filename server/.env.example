PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/portfolio
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Frontend origin for CORS. In production (on Render), set this to your Vercel URL:
# CLIENT_URL=https://<your-vercel-app>.vercel.app
CLIENT_URL=http://localhost:5173

# GitHub integration (Phase 7). Username alone is enough for profile, repo,
# star/fork, language, and recent-activity data via the public REST API.
GITHUB_USERNAME=vedantpatil04
# Optional. Add a fine-grained personal access token (no scopes needed for
# public data) to additionally enable the real contribution heatmap and
# pinned repos, both of which require the GraphQL API. Leave blank to omit
# those two pieces rather than fake them.
GITHUB_TOKEN=

# Only read by `npm run seed:admin` — not required for the server itself.
# Never commit real values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
