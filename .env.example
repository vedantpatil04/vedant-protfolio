# API Base URL: in production (Vercel) and development (Vite dev proxy),
# use relative /api so requests flow through the proxy to Render:
# - Production: Vercel proxy (/api/* -> https://vedant-protfolio.onrender.com/api/*)
# - Development: Vite proxy (/api/* -> http://localhost:4000/api/*)
VITE_API_BASE_URL=/api
